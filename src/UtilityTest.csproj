<Project Sdk="Microsoft.NET.Sdk">
    <!--=====================================================================================================================================================-->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);Z_UP;</DefineConstants>
    </PropertyGroup>

    <!--=====================================================================================================================================================-->
    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>

        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ErrorReport>none</ErrorReport>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>

        <!-- <Configuration>Debug</Configuration> -->
        <!-- <Configuration>Release</Configuration> -->
        <!-- <Platform>Any CPU</Platform> -->

        <StartupObject>UtilityTest.Program</StartupObject>
    </PropertyGroup>
    <!--=====================================================================================================================================================-->
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <OutputType>Exe</OutputType>    <!-- Enable console printout when using "dotnet.exe run" -->
        <DebugType>full</DebugType><DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutputType>Exe</OutputType>
        <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
        <!-- <DebugType>full</DebugType><DebugSymbols>true</DebugSymbols> -->
    </PropertyGroup>
    <!--=====================================================================================================================================================-->
    <!--                                                                    PUBLISH                                                                          -->
    <!--                                           These parameters only apply when using:    dotnet.exe publish                                             -->
    <PropertyGroup>
        <PublishAot>true</PublishAot>                       <!--  Compile to native EXE.    .NET Runtime/JIT is not used.                  -->
        <!--<PublishSingleFile>false</PublishSingleFile>--> <!--  Embed everything into single EXE file.    Not applicable to 'PublishAot' -->
        <!--<PublishReadyToRun>false</PublishReadyToRun>--> <!--  Include .NET Runtime.                     Not applicable to 'PublishAot' -->

        <PublishProtocol>FileSystem</PublishProtocol>
        <_TargetId>Folder</_TargetId>
        <PublishDir>..\</PublishDir>

        <PublishTrimmed>true</PublishTrimmed>               <!--  -->
        <TrimMode>full</TrimMode>                           <!--  -->
        <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>   <!--  -->
    </PropertyGroup>

    <!--=====================================================================================================================================================-->
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);_IGNORE_\**</DefaultItemExcludes>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>
</Project>
